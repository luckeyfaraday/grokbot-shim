# Optional: required only for models routed through OpenRouter.
OPENROUTER_API_KEY=

# The public Cursor plugin marketplace is bridged locally by default. Catalog
# metadata is read from the public marketplace page and cached under state/;
# installing a plugin then clones its pinned public Git repository. Disable it
# only if you deliberately want the old empty panel.
# PLUGIN_MARKETPLACE=off

# Optional: add private/team marketplace reads from a real upstream account.
# Public plugins do not need these settings.
# PLUGIN_MARKETPLACE=private
# PLUGIN_PROXY=1
# UPSTREAM_TOKEN=
# The isolated profile invents its own machine id, so the checksum the app
# sends names a different machine than the one UPSTREAM_TOKEN was issued to.
# UPSTREAM_MACHINE_ID=

# Optional overrides.
# GROKBOT_APP=/opt/Grok Bot/sand
# GROKBOT_RESOURCES=/opt/Grok Bot/resources
# CODEX_HOME=/home/you/.codex
